# ─────────────────────────────────────────────────────────────────────────────
# FinQuest — Consolidated Environment Variables
# Copy this file to frontend/.env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Groq API (required for AI scenarios & Socratic tutor)
# Get key: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# HuggingFace (required for RAG embeddings)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-api-key

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Phase 2: Backend Service (placeholder) ────────────────────────────────────
# BACKEND_API_URL=http://localhost:4000

# ── Phase 2: Game Engine Service (placeholder) ────────────────────────────────
# GAME_ENGINE_URL=http://localhost:8000

# ── Phase 2: AI Service (placeholder) ────────────────────────────────────────
# AI_SERVICE_URL=http://localhost:8001
